{
  "name": "dsh-daily-report",
  "description": "日报助手持久化插件：上午素材/下午素材两个输入框，生成分点三栏 Word 日报（今日完成工作/明日计划/感悟总结）并通过钉钉发送。Host 半部负责 LLM 生成、DOCX 构建、钉钉发送；Client 半部在 Web GUI 侧栏与右下角提供入口。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0"
}
